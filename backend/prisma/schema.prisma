generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  users     User[]
  bots      Bot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model User {
  id              String        @id @default(cuid())
  uuid            String        @unique @default(uuid())
  email           String        @unique
  name            String?
  hashedPassword  String
  wallet          String?       @unique
  role            String        @default("trader") // admin, trader
  stripeCustomerId String?      @unique

  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])

  subscription    Subscription?
  apiKeys         ApiKey[]

  // Risk Metrics
  dailyPnL        Float         @default(0)
  lastEquityReset DateTime      @default(now())

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("users")
}

model Bot {
  id              String   @id @default(cuid())
  name            String
  strategy        String   @default("QLC")
  status          String   @default("off") // auto, monitor, off
  pair            String   @default("BTC/USDT")
  settings        Json?    // { capitalTotal, riskPerTrade, maxHoldTime, pingPongEnabled }

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("bots")
}

model ApiKey {
  id         String @id @default(cuid())
  userId     String
  exchange   String
  apiKey     String
  secret     String
  viewOnly   Boolean @default(true)
  user       User   @relation(fields: [userId], references: [id])
}

model Subscription {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id])
  stripeSubId   String @unique
  stripePriceId String
  status        String
}

model Order {
  id              String   @id @default(cuid())
  botId           String
  bot             Bot      @relation(fields: [botId], references: [id])

  symbol          String
  side            String   // buy, sell
  type            String   // long, short
  entryPrice      Float
  exitPrice       Float?
  amount          Float
  size            Float    // Position size in USD
  pnl             Float?
  score           Float
  status          String   @default("open") // open, closed, forced_closed
  pingPongState   String?  // none, first_stop, short_2x
  openedAt        DateTime @default(now())
  closedAt        DateTime?
  forceCloseAt    DateTime?

  @@map("orders")
}
