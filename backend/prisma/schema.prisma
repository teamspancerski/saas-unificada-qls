generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LawyerProfile {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  password          String
  OAB_UF            String
  OAB_Number        String
  Specialties       String[]
  Bio               String?
  Lat               Float?
  Long              Float?
  Rating            Float          @default(5.0)
  Stripe_Customer_ID String?       @unique
  Plan_Level        String         @default("Essential") // Essential | Professional | Elite
  WhiteLabel_Logo   String?
  Subscription_Status String       @default("inactive")
  cases             Case[]
  auditLogs         AuditLog[]
  subscriptions     Subscription[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("lawyer_profiles")
}

model Client {
  id             String   @id @default(cuid())
  name           String?
  email          String?  @unique
  last_triage_id String?
  cases          Case[]
  triages        Triage[]
  createdAt      DateTime @default(now())

  @@map("clients")
}

model Case {
  id            String   @id @default(cuid())
  lawyer_id     String
  client_id     String
  status        String   @default("Active") // Active | Archived | Priority
  timeline_json Json
  lawyer        LawyerProfile @relation(fields: [lawyer_id], references: [id])
  client        Client        @relation(fields: [client_id], references: [id])
  vaults        Vault[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("cases")
}

model Triage {
  id                  String   @id @default(cuid())
  session_id          String   @unique
  client_id           String?
  intake_data         Json
  document_links      String[]
  ai_summary          String?
  auto_classification String?
  client              Client?  @relation(fields: [client_id], references: [id])
  createdAt           DateTime @default(now())

  @@map("triages")
}

model Vault {
  id                 String   @id @default(cuid())
  document_id        String   @unique
  case_id            String
  encryption_key_ref String
  audit_log_id       String?
  case               Case     @relation(fields: [case_id], references: [id])
  createdAt          DateTime @default(now())

  @@map("vaults")
}

model Subscription {
  id                    String        @id @default(cuid())
  lawyer_id             String
  Plan_ID               String
  Stripe_Subscription_ID String       @unique
  Trial_Ends            DateTime?
  status                String
  lawyer                LawyerProfile @relation(fields: [lawyer_id], references: [id])
  createdAt             DateTime      @default(now())

  @@map("subscriptions")
}

model AuditLog {
  id         String        @id @default(cuid())
  user_id    String?
  action     String
  ip_address String?
  timestamp  DateTime      @default(now())
  lawyer     LawyerProfile? @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}
