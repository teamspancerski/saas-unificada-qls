src/routes/auth.ts:
typescript
import { FastifyInstance } from 'fastify';
import bcrypt from 'bcryptjs';
import { prisma } from '../lib/prisma';
import { z } from 'zod';

export async function authRoutes(app: FastifyInstance) {
  app.post('/register', async (req, reply) => {
    const { email, password, name } = z.object({
      email: z.string().email(),
      password: z.string().min(6),
      name: z.string().optional()
    }).parse(req.body);

    const hashedPassword = await bcrypt.hash(password, 12);
    
    try {
      const user = await prisma.user.create({
        data: { email, name, hashedPassword }
      });
      return reply.jwtSign({ userId: user.id });
    } catch (error) {
      return reply.status(400).send({ error: 'Email already exists' });
    }
  });
}
src/routes/bot.ts:
typescript
import { FastifyInstance } from 'fastify';
import { z } from 'zod';
import { prisma } from '../lib/prisma';

export async function botRoutes(app: FastifyInstance) {
  // Liga/Desliga Bot
  app.post('/bot/toggle/:userId', async (req) => {
    const { userId } = z.object({ userId: z.string() }).parse(req.params);
    const user = await prisma.user.findUnique({ where: { id: userId } });
    
    if (!user) throw new Error('User not found');
    
    const newStatus = !user.botStatus;
    await prisma.user.update({
      where: { id: userId },
      data: { botStatus: newStatus }
    });
    
    return { status: newStatus ? 'ON' : 'OFF', message: `Bot ${newStatus ? 'ligado' : 'desligado'}` };
  });

  // Signals do usuário
  app.get('/signals/:userId', async (req) => {
    const { userId } = z.object({ userId: z.string() }).parse(req.params);
    return await prisma.signal.findMany({ 
      where: { userId },
      orderBy: { createdAt: 'desc' }
    });
  });

  // Calcula position size
  app.post('/capital/calc', async (req) => {
    const { capital, risk, price } = z.object({
      capital: z.number(),
      risk: z.number(),
      price: z.number()
    }).parse(req.body);
    
    const size = (capital * (risk / 100)) / price;
    return { size: Math.floor(size * 100) / 100 };
  });
}
src/routes/stripe.ts:
typescript
import { FastifyInstance } from 'fastify';
import Stripe from 'stripe';
import { prisma } from '../lib/prisma';

const stripe = new Stripe(process.env.STRIPE_SECRET_KEY!);

export async function stripeRoutes(app: FastifyInstance) {
  app.post('/create-checkout', async (req) => {
    const { userId, priceId } = req.body as { userId: string; priceId: string };
    
    const user = await prisma.user.findUnique({ where: { id: userId } });
    if (!user) throw new Error('User not found');

    const session = await stripe.checkout.sessions.create({
      customer: user.stripeCustomerId || undefined,
      mode: 'subscription',
      payment_method_types: ['card'],
      line_items: [{ price: priceId, quantity: 1 }],
      success_url: `${req.headers.origin}/success?session_id={CHECKOUT_SESSION_ID}`,
      cancel_url: `${req.headers.origin}/cancel`,
      metadata: { userId }
    });

    return { url: session.url };
  });
}
